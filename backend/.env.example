# The backend loads environment settings from the project-root .env file
# (one directory above backend). Copy the project-root .env.example there;
# putting settings only in backend/.env will not configure the running app.
# Ask your team lead for the API keys.

GEMINI_API_KEY=your_gemini_key_here
GEMINI_VISION_MODEL=gemini-3.8-flash
STRIPE_SECRET_KEY=your_stripe_secret_key_here
PAYMONGO_SECRET_KEY=your_paymongo_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Gmail: enable 2-Step Verification, then create an App Password.
# Use the 16-character App Password, not your normal Gmail password.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FROM_EMAIL=youraddress@gmail.com
